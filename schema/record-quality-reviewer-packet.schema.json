{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Evidence Lab Record Quality Reviewer Packet",
  "type": "object",
  "required": [
    "id",
    "snapshot_id",
    "generated_at",
    "status",
    "method",
    "public_claim_limit",
    "review_scope",
    "audit_summary",
    "source_link_review",
    "priority_queues",
    "reviewer_checklist",
    "next_internal_actions"
  ],
  "properties": {
    "id": { "type": "string", "const": "record_quality_reviewer_packet_v1" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "type": "string", "const": "internal_pre_review_packet" },
    "method": { "type": "string", "minLength": 1 },
    "public_claim_limit": { "type": "string", "minLength": 1 },
    "review_scope": {
      "type": "object",
      "required": ["records_checked", "gold_v1_records_checked", "priority_records_checked", "source_urls_checked_live"],
      "properties": {
        "records_checked": { "type": "integer", "minimum": 0 },
        "gold_v1_records_checked": { "type": "integer", "minimum": 0 },
        "priority_records_checked": { "type": "integer", "minimum": 0 },
        "source_urls_checked_live": { "type": "integer", "minimum": 0 }
      }
    },
    "audit_summary": {
      "type": "object",
      "required": ["status_counts", "highest_severity_counts", "top_issue_counts"],
      "properties": {
        "status_counts": { "type": "object" },
        "highest_severity_counts": { "type": "object" },
        "top_issue_counts": { "type": "object" }
      }
    },
    "source_link_review": {
      "type": "object",
      "required": [
        "sources_checked_live",
        "hard_broken_sources",
        "locator_risk_sources",
        "records_affected_by_broken_sources",
        "records_affected_by_locator_risk"
      ],
      "properties": {
        "sources_checked_live": { "type": "integer", "minimum": 0 },
        "hard_broken_sources": { "type": "array" },
        "locator_risk_sources": { "type": "array" },
        "records_affected_by_broken_sources": { "type": "array", "items": { "type": "string" } },
        "records_affected_by_locator_risk": { "type": "array", "items": { "type": "string" } }
      }
    },
    "priority_queues": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": { "$ref": "#/$defs/queue" }
    },
    "reviewer_checklist": { "type": "array", "minItems": 6, "items": { "type": "string", "minLength": 1 } },
    "next_internal_actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "queue": {
      "type": "object",
      "required": ["id", "label", "description", "records"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event_id",
              "school_id",
              "audit_status",
              "review_score",
              "highest_severity",
              "issue_ids",
              "workspace_url",
              "event_url",
              "challenge_url"
            ],
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "school_id": { "type": "string", "minLength": 1 },
              "audit_status": { "type": "string", "minLength": 1 },
              "review_score": { "type": "integer", "minimum": 0 },
              "highest_severity": { "type": "string", "minLength": 1 },
              "issue_ids": { "type": "array", "items": { "type": "string" } },
              "workspace_url": { "type": "string", "minLength": 1 },
              "event_url": { "type": "string", "minLength": 1 },
              "challenge_url": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
