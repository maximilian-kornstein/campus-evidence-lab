{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusevidencelab.org/schema/certification-batches.schema.json",
  "title": "Campus Evidence Lab Certification Batches",
  "type": "object",
  "required": [
    "id",
    "snapshot_id",
    "generated_at",
    "status",
    "method",
    "public_claim_limit",
    "certification_standard_version",
    "batch_size",
    "completion_rule",
    "totals",
    "lanes",
    "batches"
  ],
  "properties": {
    "id": { "const": "certification_batches_v1" },
    "snapshot_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "status": { "type": "string" },
    "method": { "type": "string" },
    "public_claim_limit": { "type": "string" },
    "certification_standard_version": { "const": "certification_rules_v1" },
    "batch_size": { "type": "integer", "minimum": 1 },
    "completion_rule": { "type": "string" },
    "totals": { "type": "object" },
    "lanes": { "type": "object" },
    "batches": { "type": "array" }
  }
}
