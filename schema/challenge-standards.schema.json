{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Evidence Lab Challenge Standards",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "generated_at", "method", "standards"],
  "properties": {
    "snapshot_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "method": { "type": "string", "minLength": 1 },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "applies_when",
          "acceptable_counterevidence",
          "insufficient_counterevidence",
          "possible_outcomes",
          "fields_that_may_change",
          "no_overclaiming_warning"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "category_challenge",
              "affected_community_challenge",
              "confidence_challenge",
              "date_precision_challenge",
              "institutional_response_challenge",
              "legal_status_challenge",
              "source_sufficiency_challenge",
              "inclusion_challenge"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "applies_when": { "type": "string", "minLength": 1 },
          "acceptable_counterevidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "insufficient_counterevidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "possible_outcomes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "fields_that_may_change": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "no_overclaiming_warning": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
