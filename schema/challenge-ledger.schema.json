{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Evidence Lab Challenge Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "updated_at", "method", "statuses", "entries"],
  "properties": {
    "snapshot_id": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "method": { "type": "string", "minLength": 1 },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/status" }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "challenge_id",
          "event_id",
          "challenge_type",
          "status",
          "submitted_evidence_summary",
          "decision_summary",
          "resulting_correction_ids",
          "resulting_event_ids",
          "updated_at",
          "public_limitations"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "challenge_id": { "type": "string", "minLength": 1 },
          "event_id": { "type": "string", "minLength": 1 },
          "challenge_type": { "$ref": "#/$defs/challenge_id" },
          "status": { "$ref": "#/$defs/status" },
          "submitted_evidence_summary": { "type": "string", "minLength": 1 },
          "decision_summary": { "type": "string", "minLength": 1 },
          "resulting_correction_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "resulting_event_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "public_limitations": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "challenge_id": {
      "type": "string",
      "enum": [
        "category_challenge",
        "affected_community_challenge",
        "confidence_challenge",
        "date_precision_challenge",
        "institutional_response_challenge",
        "legal_status_challenge",
        "source_sufficiency_challenge",
        "inclusion_challenge"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft_packet",
        "open_for_review",
        "under_review",
        "accepted",
        "partially_accepted",
        "rejected",
        "needs_more_evidence",
        "closed_no_change"
      ]
    }
  }
}
