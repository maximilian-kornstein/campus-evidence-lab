{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Evidence Lab Challenge Queues",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "generated_at", "method", "queue_count", "packet_count", "queues", "packets"],
  "properties": {
    "snapshot_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "method": { "type": "string", "minLength": 1 },
    "queue_count": { "type": "integer", "minimum": 0 },
    "packet_count": { "type": "integer", "minimum": 0 },
    "queues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "records"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "school_id",
                "school_name",
                "category",
                "affected_communities",
                "confidence",
                "date_precision",
                "challenge_types",
                "reason_codes",
                "source_count",
                "packet_url",
                "event_url",
                "workspace_url"
              ],
              "properties": {
                "event_id": { "type": "string", "minLength": 1 },
                "school_id": { "type": "string", "minLength": 1 },
                "school_name": { "type": "string", "minLength": 1 },
                "category": { "type": "string", "minLength": 1 },
                "affected_communities": { "type": "array", "items": { "type": "string" } },
                "confidence": { "type": "string", "minLength": 1 },
                "date_precision": { "type": "string", "minLength": 1 },
                "challenge_types": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/challenge_id" }
                },
                "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "source_count": { "type": "integer", "minimum": 0 },
                "import_family": { "type": "string" },
                "locator_quality": { "type": "string" },
                "packet_url": { "type": "string", "minLength": 1 },
                "event_url": { "type": "string", "minLength": 1 },
                "workspace_url": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "packets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event_id",
          "school_id",
          "school_name",
          "category",
          "affected_communities",
          "confidence",
          "date_precision",
          "source_ids",
          "source_types",
          "challenge_types",
          "reason_codes",
          "review_questions",
          "acceptable_counterevidence",
          "possible_outcomes",
          "evidence_capsule_url",
          "event_url",
          "workspace_url",
          "submission_packet_url",
          "public_claim_limit"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "event_id": { "type": "string", "minLength": 1 },
          "school_id": { "type": "string", "minLength": 1 },
          "school_name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "affected_communities": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "minLength": 1 },
          "date_precision": { "type": "string", "minLength": 1 },
          "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "source_types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "challenge_types": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/challenge_id" }
          },
          "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "review_questions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "acceptable_counterevidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "possible_outcomes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_capsule_url": { "type": "string", "minLength": 1 },
          "event_url": { "type": "string", "minLength": 1 },
          "workspace_url": { "type": "string", "minLength": 1 },
          "submission_packet_url": { "type": "string", "minLength": 1 },
          "public_claim_limit": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "challenge_id": {
      "type": "string",
      "enum": [
        "category_challenge",
        "affected_community_challenge",
        "confidence_challenge",
        "date_precision_challenge",
        "institutional_response_challenge",
        "legal_status_challenge",
        "source_sufficiency_challenge",
        "inclusion_challenge"
      ]
    }
  }
}
