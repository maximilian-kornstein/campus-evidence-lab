{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusevidencelab.org/schema/release-verification.schema.json",
  "title": "Campus Evidence Lab Release Verification",
  "type": "object",
  "required": ["version", "generated_at", "snapshot_id", "snapshot_hash", "status", "commands", "tool_versions", "notes"],
  "properties": {
    "version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date" },
    "snapshot_id": { "type": "string" },
    "snapshot_hash": { "type": "string" },
    "status": { "type": "string", "enum": ["passed", "failed"] },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status"],
        "properties": {
          "command": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed"] }
        }
      }
    },
    "tool_versions": {
      "type": "object",
      "required": ["node", "npm"],
      "properties": {
        "node": { "type": "string" },
        "npm": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
