{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Evidence Lab Gold Record v1 Review Packets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "snapshot_id",
    "generated_at",
    "status",
    "public_claim_limit",
    "selection_version",
    "selection_criteria",
    "coverage_summary",
    "selection_note",
    "records"
  ],
  "properties": {
    "id": { "type": "string", "const": "gold_record_v1_review_packets" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "type": "string", "const": "review_packets" },
    "public_claim_limit": { "type": "string", "minLength": 40 },
    "selection_version": { "type": "string", "minLength": 1 },
    "selection_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "coverage_summary": { "type": "object" },
    "selection_note": { "type": "string", "minLength": 40 },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event_id",
          "school_id",
          "school_name",
          "state",
          "status",
          "review_score",
          "selection_reason",
          "category",
          "affected_communities",
          "confidence",
          "date",
          "date_precision",
          "event_url",
          "school_url",
          "workspace_url",
          "correction_url",
          "challenge_url",
          "source_basis",
          "rationale_packet",
          "review_questions",
          "public_claim_limit"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "event_id": { "type": "string", "minLength": 1 },
          "school_id": { "type": "string", "minLength": 1 },
          "school_name": { "type": "string", "minLength": 1 },
          "state": { "type": ["string", "null"] },
          "status": { "type": "string", "const": "gold_v1_review_packet" },
          "review_score": { "type": "number" },
          "selection_reason": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "affected_communities": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "date_precision": { "type": "string", "minLength": 1 },
          "event_url": { "type": "string", "minLength": 1 },
          "school_url": { "type": "string", "minLength": 1 },
          "workspace_url": { "type": "string", "minLength": 1 },
          "correction_url": { "type": "string", "minLength": 1 },
          "challenge_url": { "type": "string", "minLength": 1 },
          "source_basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "source_type", "source_url", "external_url"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "source_type": { "type": "string", "minLength": 1 },
                "source_url": { "type": "string", "minLength": 1 },
                "external_url": { "type": ["string", "null"] }
              }
            }
          },
          "rationale_packet": {
            "type": "object",
            "additionalProperties": false,
            "required": ["classification_rationale", "community_rationale", "confidence_rationale", "response_note"],
            "properties": {
              "classification_rationale": { "type": "string", "minLength": 1 },
              "community_rationale": { "type": "string", "minLength": 1 },
              "confidence_rationale": { "type": "string", "minLength": 1 },
              "response_note": { "type": "string", "minLength": 1 }
            }
          },
          "review_questions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "public_claim_limit": { "type": "string", "minLength": 40 }
        }
      }
    }
  }
}
