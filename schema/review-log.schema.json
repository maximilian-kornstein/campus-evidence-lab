{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusevidencelab.org/schema/review-log.schema.json",
  "title": "Campus Evidence Lab Review Log",
  "type": "object",
  "required": ["version", "updated_at", "queues", "decision_counts", "review_tier_counts", "service_standard"],
  "properties": {
    "version": { "type": "string" },
    "updated_at": { "type": "string", "format": "date" },
    "queues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "public_entrypoint", "accepted_evidence", "excluded_evidence"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "paused", "closed"] },
          "public_entrypoint": { "type": "string" },
          "accepted_evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "excluded_evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "decision_counts": {
      "type": "object",
      "required": ["pending", "accepted", "rejected", "needs_more_evidence"],
      "properties": {
        "pending": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "needs_more_evidence": { "type": "integer", "minimum": 0 }
      }
    },
    "review_tier_counts": {
      "type": "object",
      "required": [
        "imported_public_source",
        "source_family_checked",
        "internally_certified",
        "externally_reviewed"
      ],
      "properties": {
        "imported_public_source": { "type": "integer", "minimum": 0 },
        "source_family_checked": { "type": "integer", "minimum": 0 },
        "internally_certified": { "type": "integer", "minimum": 0 },
        "externally_reviewed": { "type": "integer", "minimum": 0 }
      }
    },
    "service_standard": {
      "type": "object",
      "required": ["triage_target_days", "publication_rule", "correction_rule"],
      "properties": {
        "triage_target_days": { "type": "integer", "minimum": 1 },
        "publication_rule": { "type": "string" },
        "correction_rule": { "type": "string" }
      }
    }
  }
}
