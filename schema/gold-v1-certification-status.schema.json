{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Evidence Lab Gold v1 Certification Status",
  "type": "object",
  "required": [
    "id",
    "snapshot_id",
    "generated_at",
    "status",
    "method",
    "public_claim_limit",
    "certification_gates",
    "totals",
    "records"
  ],
  "properties": {
    "id": { "type": "string", "const": "gold_v1_certification_status" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "type": "string", "const": "internal_certification_gate_status" },
    "method": { "type": "string", "minLength": 1 },
    "public_claim_limit": { "type": "string", "minLength": 1 },
    "certification_gates": { "type": "array", "minItems": 7, "items": { "type": "string" } },
    "totals": {
      "type": "object",
      "required": ["records", "certified", "not_certified", "blocked"],
      "properties": {
        "records": { "type": "integer", "minimum": 0 },
        "certified": { "type": "integer", "minimum": 0 },
        "not_certified": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "certification_status",
          "audit_status",
          "issue_ids",
          "gates",
          "workspace_url",
          "event_url",
          "challenge_url"
        ],
        "properties": {
          "event_id": { "type": "string", "minLength": 1 },
          "school_name": { "type": ["string", "null"] },
          "category": { "type": ["string", "null"] },
          "confidence": { "type": ["string", "null"] },
          "certification_status": { "type": "string", "enum": ["certified", "not_certified", "blocked"] },
          "audit_status": { "type": "string", "minLength": 1 },
          "issue_ids": { "type": "array", "items": { "type": "string" } },
          "gates": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["status", "detail", "required_action"],
              "properties": {
                "status": { "type": "string", "enum": ["pass", "needs_review", "fail"] },
                "detail": { "type": "string", "minLength": 1 },
                "required_action": { "type": "string", "minLength": 1 }
              }
            }
          },
          "workspace_url": { "type": "string", "minLength": 1 },
          "event_url": { "type": "string", "minLength": 1 },
          "challenge_url": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
