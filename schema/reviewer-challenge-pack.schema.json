{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Evidence Lab Reviewer Challenge Pack",
  "type": "object",
  "required": ["snapshot_id", "generated_at", "method", "records"],
  "properties": {
    "snapshot_id": { "type": "string" },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "method": { "type": "string", "minLength": 40 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "school_id", "source_count", "source_types", "response_depth", "challenge_reason_codes", "workspace_url", "reviewer_prompt"],
        "properties": {
          "event_id": { "type": "string" },
          "school_id": { "type": "string" },
          "source_count": { "type": "number" },
          "source_types": { "type": "array", "items": { "type": "string" } },
          "response_depth": { "type": "string" },
          "challenge_reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "workspace_url": { "type": "string" },
          "reviewer_prompt": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
