{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Evidence Lab External Review Packet",
  "type": "object",
  "required": [
    "id",
    "snapshot_id",
    "generated_at",
    "status",
    "method",
    "public_claim_limit",
    "selection_standard",
    "totals",
    "review_batches",
    "challenge_templates",
    "known_limits",
    "records"
  ],
  "properties": {
    "id": { "type": "string", "const": "external_review_packet_v1" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "type": "string", "const": "public_external_review_packet" },
    "method": { "type": "string", "minLength": 1 },
    "public_claim_limit": { "type": "string", "minLength": 1 },
    "selection_standard": {
      "type": "object",
      "required": ["source", "rule", "max_records", "selected_records"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "max_records": { "type": "integer", "minimum": 1, "maximum": 25 },
        "selected_records": { "type": "integer", "minimum": 0, "maximum": 25 }
      }
    },
    "totals": {
      "type": "object",
      "required": ["records", "certified_gold_v1_available", "excluded_not_certified_gold_v1", "excluded_blocked_gold_v1"],
      "properties": {
        "records": { "type": "integer", "minimum": 0, "maximum": 25 },
        "certified_gold_v1_available": { "type": "integer", "minimum": 0 },
        "excluded_not_certified_gold_v1": { "type": "integer", "minimum": 0 },
        "excluded_blocked_gold_v1": { "type": "integer", "minimum": 0 }
      }
    },
    "review_batches": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label", "batch_size", "record_ids", "review_standard"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "batch_size": { "type": "integer", "minimum": 0 },
          "record_ids": { "type": "array", "items": { "type": "string" } },
          "review_standard": { "type": "string", "minLength": 1 },
          "workspace_url": { "type": "string" }
        }
      }
    },
    "challenge_templates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "label", "prompt", "required_evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "required_evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "known_limits": {
      "type": "object",
      "required": ["unresolved_records", "source_family_counts", "top_issue_counts", "note"],
      "properties": {
        "unresolved_records": { "type": "object" },
        "source_family_counts": { "type": "object" },
        "top_issue_counts": { "type": "object" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "records": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "school_id",
          "date",
          "date_precision",
          "category",
          "affected_communities",
          "confidence",
          "source_ids",
          "source_types",
          "source_family",
          "gold_v1_certification_status",
          "debt_status",
          "source_locators",
          "source_checklist",
          "replication_steps",
          "challenge_url",
          "workspace_url",
          "event_url"
        ],
        "properties": {
          "event_id": { "type": "string", "minLength": 1 },
          "school_id": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "date_precision": { "type": "string", "enum": ["day", "month", "year"] },
          "category": { "type": "string", "minLength": 1 },
          "affected_communities": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string", "enum": ["High", "Medium", "Low"] },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "source_types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "source_family": { "type": "string", "minLength": 1 },
          "gold_v1_certification_status": { "type": "string", "const": "certified" },
          "debt_status": { "type": "string", "minLength": 1 },
          "response_depth": { "type": ["string", "null"] },
          "source_locators": { "type": "array" },
          "source_checklist": { "type": "array", "minItems": 6, "items": { "type": "string" } },
          "replication_steps": { "type": "array", "minItems": 6, "items": { "type": "string" } },
          "challenge_url": { "type": "string", "minLength": 1 },
          "workspace_url": { "type": "string", "minLength": 1 },
          "event_url": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
