{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Evidence Lab Review Debt Ledger",
  "type": "object",
  "required": [
    "id",
    "snapshot_id",
    "generated_at",
    "status",
    "method",
    "public_claim_limit",
    "status_definitions",
    "totals",
    "debt_status_counts",
    "source_family_counts",
    "source_family_debt",
    "issue_counts",
    "safe_repair_policy",
    "queues",
    "records"
  ],
  "properties": {
    "id": { "type": "string", "const": "review_debt_ledger_v1" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "type": "string", "const": "whole_database_review_debt_ledger" },
    "method": { "type": "string", "minLength": 1 },
    "public_claim_limit": { "type": "string", "minLength": 1 },
    "status_definitions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["status", "meaning"],
        "properties": {
          "status": { "type": "string", "minLength": 1 },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "records",
        "source_families",
        "blocked",
        "high_review_debt",
        "medium_review_debt",
        "low_review_debt",
        "lower_priority_review_debt",
        "queue_records_available"
      ],
      "properties": {
        "records": { "type": "integer", "minimum": 0 },
        "source_families": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "high_review_debt": { "type": "integer", "minimum": 0 },
        "medium_review_debt": { "type": "integer", "minimum": 0 },
        "low_review_debt": { "type": "integer", "minimum": 0 },
        "lower_priority_review_debt": { "type": "integer", "minimum": 0 },
        "queue_records_available": { "type": "integer", "minimum": 0 }
      }
    },
    "debt_status_counts": { "type": "object" },
    "source_family_counts": { "type": "object" },
    "source_family_debt": { "type": "object" },
    "issue_counts": { "type": "object" },
    "safe_repair_policy": {
      "type": "object",
      "required": ["applied_batch_repairs", "deferred_batch_repairs", "rule"],
      "properties": {
        "applied_batch_repairs": { "type": "array", "items": { "type": "string" } },
        "deferred_batch_repairs": { "type": "array", "items": { "type": "string" } },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "queues": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "label", "description", "records"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "records": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/$defs/queue_record" }
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "queue_record": {
      "type": "object",
      "required": [
        "event_id",
        "school_id",
        "source_family",
        "debt_status",
        "repair_priority",
        "issue_ids",
        "event_url",
        "workspace_url",
        "challenge_url"
      ],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "school_id": { "type": "string", "minLength": 1 },
        "source_family": { "type": "string", "minLength": 1 },
        "debt_status": { "type": "string", "minLength": 1 },
        "repair_priority": { "type": "integer", "minimum": 0 },
        "issue_ids": { "type": "array", "items": { "type": "string" } },
        "event_url": { "type": "string", "minLength": 1 },
        "workspace_url": { "type": "string", "minLength": 1 },
        "challenge_url": { "type": "string", "minLength": 1 }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "event_id",
        "school_id",
        "source_family",
        "debt_status",
        "public_use_status",
        "issue_ids",
        "debt_reasons",
        "repair_priority",
        "audit_status",
        "highest_severity",
        "review_score",
        "source_types",
        "confidence",
        "date_precision",
        "response_depth",
        "source_count",
        "event_url",
        "workspace_url"
      ],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "school_id": { "type": "string", "minLength": 1 },
        "source_family": { "type": "string", "minLength": 1 },
        "debt_status": {
          "type": "string",
          "enum": ["blocked", "high_review_debt", "medium_review_debt", "low_review_debt", "lower_priority_review_debt"]
        },
        "public_use_status": { "type": "string", "minLength": 1 },
        "issue_ids": { "type": "array", "items": { "type": "string" } },
        "debt_reasons": { "type": "array", "items": { "type": "string" } },
        "repair_priority": { "type": "integer", "minimum": 0 },
        "audit_status": { "type": "string", "minLength": 1 },
        "highest_severity": { "type": "string", "enum": ["blocker", "high", "medium", "low", "none"] },
        "review_score": { "type": "integer", "minimum": 0 },
        "source_types": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "date_precision": { "type": "string", "enum": ["day", "month", "year"] },
        "response_depth": { "type": ["string", "null"] },
        "source_count": { "type": "integer", "minimum": 0 },
        "event_url": { "type": "string", "minLength": 1 },
        "workspace_url": { "type": "string", "minLength": 1 }
      }
    }
  }
}
