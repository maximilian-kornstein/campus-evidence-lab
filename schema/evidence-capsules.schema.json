{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Evidence Lab Evidence Capsules",
  "type": "object",
  "required": ["snapshot_id", "generated_at", "method", "totals", "import_family_counts", "locator_quality_counts", "review_need_counts", "records"],
  "properties": {
    "snapshot_id": { "type": "string" },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "method": { "type": "string", "minLength": 40 },
    "totals": { "type": "object" },
    "import_family_counts": { "type": "object" },
    "locator_quality_counts": { "type": "object" },
    "review_need_counts": { "type": "object" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "school_id", "category", "confidence", "date_precision", "import_family", "locator_quality", "source_basis", "field_evidence", "review_needs", "workspace_url", "event_url", "public_claim_limit"],
        "properties": {
          "event_id": { "type": "string" },
          "school_id": { "type": "string" },
          "category": { "type": "string" },
          "confidence": { "type": "string" },
          "date_precision": { "type": "string" },
          "import_family": { "type": "object" },
          "locator_quality": { "type": "object" },
          "source_basis": { "type": "object" },
          "field_evidence": { "type": "array", "minItems": 1 },
          "review_needs": { "type": "array", "items": { "type": "string" } },
          "workspace_url": { "type": "string" },
          "event_url": { "type": "string" },
          "public_claim_limit": { "type": "string", "minLength": 40 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
