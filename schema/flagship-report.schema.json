{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Evidence Lab Flagship Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "snapshot_id",
    "snapshot_hash",
    "generated_at",
    "thesis",
    "public_claim_limit",
    "recommended_next_reviews",
    "audience_paths",
    "inputs",
    "findings"
  ],
  "properties": {
    "id": { "type": "string", "const": "flagship_public_evidence_infrastructure_v1" },
    "title": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "snapshot_hash": { "type": ["string", "null"] },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "thesis": { "type": "string", "minLength": 40 },
    "public_claim_limit": { "type": "string", "minLength": 40 },
    "recommended_next_reviews": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "audience_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audience", "path", "use"],
        "properties": {
          "audience": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "use": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "schools", "sources", "challenge_packets"],
      "properties": {
        "events": { "type": "integer", "minimum": 0 },
        "schools": { "type": "integer", "minimum": 0 },
        "sources": { "type": "integer", "minimum": 0 },
        "challenge_packets": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "metric", "evidence_links", "challenge_url", "use_limit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "metric": { "type": "object" },
          "evidence_links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "url", "note"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 },
                "note": { "type": "string", "minLength": 1 }
              }
            }
          },
          "challenge_url": { "type": "string", "minLength": 1 },
          "use_limit": { "type": "string", "minLength": 40 }
        }
      }
    }
  }
}
