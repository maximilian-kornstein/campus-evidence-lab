{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusevidencelab.org/schema/ed-certification-batch-review.schema.json",
  "title": "Campus Evidence Lab ED Certification Batch Review",
  "type": "object",
  "required": [
    "id",
    "snapshot_id",
    "generated_at",
    "review_batch_id",
    "source_batch_id",
    "status",
    "certification_standard_version",
    "selection_method",
    "method",
    "public_claim_limit",
    "completion_rule",
    "totals",
    "status_counts",
    "open_gate_counts",
    "provenance_status_counts",
    "records"
  ],
  "properties": {
    "id": { "const": "ed_certification_batch_001_review_v1" },
    "snapshot_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "review_batch_id": { "const": "ed_dataset_batch_001" },
    "source_batch_id": { "const": "ed_dataset_batch_001" },
    "status": { "const": "bounded_internal_source_to_record_review" },
    "certification_standard_version": { "const": "certification_rules_v1" },
    "selection_method": { "type": "string" },
    "method": { "type": "string" },
    "public_claim_limit": { "type": "string" },
    "completion_rule": { "type": "string" },
    "totals": { "type": "object" },
    "status_counts": { "type": "object" },
    "open_gate_counts": { "type": "object" },
    "provenance_status_counts": { "type": "object" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "school_id",
          "source_family",
          "review_batch_id",
          "certification_standard_version",
          "certification_status",
          "certification_basis",
          "open_gates",
          "gate_reviews",
          "next_action",
          "event_url",
          "workspace_url",
          "challenge_url"
        ],
        "properties": {
          "event_id": { "type": "string" },
          "school_id": { "type": ["string", "null"] },
          "source_family": { "const": "ed_campus_safety_dataset" },
          "review_batch_id": { "const": "ed_dataset_batch_001" },
          "certification_standard_version": { "const": "certification_rules_v1" },
          "certification_status": { "enum": ["certified", "not_certified", "blocked"] },
          "certification_basis": { "type": ["string", "null"] },
          "not_certified_reason": { "type": ["string", "null"] },
          "blocked_reason": { "type": ["string", "null"] },
          "source_locator": { "type": ["object", "null"] },
          "provenance_status": { "type": "string" },
          "code_tag": { "type": ["string", "null"] },
          "expected_column": { "type": ["string", "null"] },
          "expected_count": { "type": ["number", "null"] },
          "source_year": { "type": ["string", "null"] },
          "open_gates": { "type": "array", "items": { "type": "string" } },
          "gate_reviews": { "type": "object" },
          "source_specific_rationales": { "type": "object" },
          "next_action": { "type": "string" },
          "event_url": { "type": "string" },
          "workspace_url": { "type": "string" },
          "challenge_url": { "type": "string" }
        }
      }
    }
  }
}
