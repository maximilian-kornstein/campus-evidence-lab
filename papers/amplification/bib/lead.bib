% Facts used from eu2022dsa (Regulation (EU) 2022/2065; entry in
% bib/sources.bib), checked via web search restricted to eur-lex.europa.eu
% (OJ L 277 text, consolidated text and General Court judgment T-367/23,
% which quotes the recital), November 2026:
%  - Recital 70: recommender systems "can have a significant impact on the
%    ability of recipients to retrieve and interact with information online"
%    and "play an important role in the amplification of certain messages,
%    the viral dissemination of information and the stimulation of online
%    behaviour".
%  - Art. 33(1): the obligations for very large online platforms and search
%    engines apply to services with average monthly active recipients in the
%    Union equal to or higher than 45 million that are designated under
%    Art. 33(4); Recital 75 equates 45 million with 10% of the Union population.
%  - Art. 34(1)(b): systemic risks include negative effects on fundamental
%    rights, naming human dignity (Art. 1 of the Charter) and
%    non-discrimination (Art. 21 of the Charter). Art. 34(2) (the design of
%    recommender systems as a factor the assessment must take into account)
%    is as stated by SOURCES in sec:bg-governance; the Introduction cites
%    only "Article 34".

% Supports: the third FRA survey of Jewish people (online survey, January to
% June 2023, almost 8,000 Jewish respondents aged 16 or over in 13 EU Member
% States: AT, BE, CZ, DK, FR, DE, HU, IT, NL, PL, RO, ES, SE); 90% of
% respondents encountered antisemitism online in the 12 months before the
% survey; fieldwork ended before 7 October 2023. Published 11 July 2024.
% Checked via web search restricted to fra.europa.eu and op.europa.eu (FRA
% press release of 11 July 2024, report PDF and Publications Office record),
% November 2026. Direct fetch of fra.europa.eu is blocked from this session.
@techreport{fra2024antisemitism,
  author      = {{European Union Agency for Fundamental Rights}},
  title       = {Jewish People's Experiences and Perceptions of Antisemitism},
  institution = {Publications Office of the European Union},
  address     = {Luxembourg},
  type        = {Report},
  year        = {2024},
  month       = jul,
  url         = {https://fra.europa.eu/sites/default/files/fra_uploads/fra-2024-experiences-perceptions-antisemitism-survey_en.pdf},
  note        = {Third {EU} survey on discrimination and hate crime against {J}ews. Accessed November 2026}
}

