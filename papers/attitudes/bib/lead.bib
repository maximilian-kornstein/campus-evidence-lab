% Supports: Executive Order 13899, "Combating Anti-Semitism", signed 11 December
% 2019, published 16 December 2019 at 84 FR 68779. Sec. 2(a): agencies charged
% with enforcing Title VI shall consider the IHRA non-legally binding working
% definition (adopted 26 May 2016) and the IHRA "Contemporary Examples of
% Anti-Semitism", "to the extent that any examples might be useful as evidence
% of discriminatory intent". Sec. 2(b): agencies shall not diminish or infringe
% upon any right protected under Federal law or under the First Amendment.
% Sec. 1: students "continue to face anti-Semitic harassment in schools and on
% university and college campuses"; Title VI prohibits discrimination on the
% basis of race, color and national origin in programs and activities receiving
% Federal financial assistance. Checked via search on federalregister.gov and
% govinfo.gov (FR html/pdf of 2019-27217).
@article{eo13899,
  author  = {{Executive Office of the President}},
  title   = {Executive Order 13899 of {December} 11, 2019: Combating Anti-Semitism},
  journal = {Federal Register},
  volume  = {84},
  number  = {241},
  pages   = {68779},
  year    = {2019},
  month   = dec,
  note    = {Published 16 December 2019. Document 2019-27217},
  url     = {https://www.federalregister.gov/documents/2019/12/16/2019-27217/combating-anti-semitism}
}

