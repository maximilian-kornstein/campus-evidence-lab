% NOTE: the FBI's Supplemental Hate Crime Statistics, 2021 is cited as fbi2023supp
% (with doj2023hate2021), both defined in bib/sources.bib; LEAD's duplicate removed.

% Supports: 2023 hate-crime collection had 16,009 participating agencies with
% 95.2% population coverage; on the FBI's trend dataset (agencies with comparable
% reporting in both years) incidents fell 0.6% from 10,687 (2022) to 10,627 (2023).
% Checked via fbi.gov press release (Sept. 2024), Nov 2026.
@misc{fbi2024crimenation,
  author       = {{Federal Bureau of Investigation}},
  title        = {{FBI} Releases 2023 {Crime in the Nation} Statistics},
  howpublished = {Press release, U.S. Department of Justice},
  year         = {2024},
  month        = sep,
  url          = {https://www.fbi.gov/news/press-releases/fbi-releases-2023-crime-in-the-nation-statistics}
}

% Supports: FBI 2023 data -- 2,699 incidents with a religious bias motivation, of
% which 1,832 were motivated by anti-Jewish bias; 11,862 incidents in total in
% 2023, up from 11,634 in 2022.
% Checked via justice.gov/crs page, Nov 2026.
@misc{dojcrs2024,
  author       = {{U.S. Department of Justice, Community Relations Service}},
  title        = {{2023 Hate Crime Statistics}},
  howpublished = {Summary of the FBI's 2023 hate crime data},
  year         = {2024},
  url          = {https://www.justice.gov/crs/news/2023-hate-crime-statistics}
}

